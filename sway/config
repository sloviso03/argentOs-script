include /etc/sway/config-vars.d/*
include /etc/sway/config.d/*
include ~/.config/sway/outputs

set $mod Mod4
set $term foot
set $file-explorer dolphin
set $browser firefox

seat seat0 xcursor_theme Bibata-Modern-Ice 24
exec_always {
    gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Ice'
    gsettings set org.gnome.desktop.interface cursor-size 24
    hash dbus-update-activation-environment 2>/dev/null && \
    dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK
    dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME=qt5ct GTK_THEME
}

exec_always autotiling
exec noctalia
exec nm-applet --indicator
exec udiskie --smart-tray
exec bluetoothctl power on
exec /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1

bindsym $mod+Return exec $term
bindsym $mod+w exec $browser
bindsym $mod+q kill
bindsym $mod+e exec $file-explorer
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next
bindsym Print exec grim -g "$(slurp)" ~/Pictures/Screenshot_$(date +'%Y%m%d_%H%M%S').png && wl-copy < ~/Pictures/Screenshot_$(date +'%Y%m%d_%H%M%S').png
bindsym $mod+Shift+s exec grim -g "$(slurp)" ~/Pictures/Screenshot_$(date +'%Y%m%d_%H%M%S').png && wl-copy < ~/Pictures/Screenshot_$(date +'%Y%m%d_%H%M%S').png

set $ipc noctalia msg
bindsym $mod+space exec $ipc panel-toggle launcher
bindsym $mod+s exec $ipc panel-toggle control-center
bindsym $mod+comma exec $ipc settings-toggle
bindsym --locked XF86AudioRaiseVolume exec $ipc volume-up
bindsym --locked XF86AudioLowerVolume exec $ipc volume-down
bindsym --locked XF86AudioMute exec $ipc volume-mute
bindsym --locked XF86MonBrightnessUp exec $ipc brightness-up
bindsym --locked XF86MonBrightnessDown exec $ipc brightness-down

floating_modifier $mod normal
bindsym $mod+Shift+r reload

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left; move left
bindsym $mod+Shift+j move down; move down
bindsym $mod+Shift+k move up; move up
bindsym $mod+Shift+l move right; move right

bindsym $mod+Shift+Left move left; move left
bindsym $mod+Shift+Down move down; move down
bindsym $mod+Shift+Up move up; move up
bindsym $mod+Shift+Right move right; move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+V layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle, resize set width 800 px height 500 px, move position center

bindsym $mod+Shift+z mode "resize"
mode "resize" {
    bindsym h resize shrink width 20px
    bindsym j resize grow height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}


input * {
    xkb_layout "latam"
}

input "type:pointer" {
    pointer_accel 0.5
    accel_profile flat
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}


include ~/.config/sway/noctalia



# ==============================================================================
# (SwayFX)

# Bordes y Espaciado
default_border pixel 1
default_floating_border none
smart_borders on

gaps inner 8
gaps outer 4
corner_radius 12


# Blur Oscuro
blur enable
blur_passes 4
blur_radius 8
blur_noise 0.15

blur_xray enable
blur_brightness 0.60
blur_contrast 1.25
blur_saturation 0.85

# Atenuado de Ventanas Inactivas
default_dim_inactive 0.10
dim_inactive_colors.unfocused #000000FF

# Sombras Sutiles
shadows enable
shadow_offset 0 8
shadow_blur_radius 25
shadow_color #000000AA
shadow_inactive_color #00000044


# Efectos en Capas (Noctalia)
layer_effects "noctalia" {
    blur enable
    blur_ignore_transparent false
    corner_radius 12
    shadows enable
}


# Esquema de Colores
client.focused          #ffffff44 #00000000 #d8dee9 #ffffff44 #ffffff44
client.focused_inactive #00000000 #00000000 #888888 #00000000 #00000000
client.unfocused        #00000000 #00000000 #555555 #00000000 #00000000
client.urgent           #bf616a88 #00000000 #eceff4 #bf616a88 #bf616a88
client.placeholder      #111111   #111111   #444444 #111111   #111111
client.background       #00000000


# AUTOSTART SERVICIOS DEL SISTEMA
exec_always --no-startup-id systemctl --user restart xdg-desktop-portal xdg-desktop-portal-kde
